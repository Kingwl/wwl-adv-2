{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WWL Level Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "style_id",
    "wave_set_id",
    "grid",
    "path_cells",
    "blocked_cells",
    "locked_cells",
    "spawn_cell",
    "exit_cell"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "style_id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "wave_set_id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "path_cells": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "blocked_cells": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "locked_cells": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "spawn_cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "exit_cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
