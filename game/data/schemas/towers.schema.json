{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WWL Tower Definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "towers"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "towers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "display_name",
          "description",
          "weapon_type",
          "attack_type",
          "damage_school",
          "attack_pattern",
          "visual_test_enabled",
          "projectile",
          "tiers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$"
          },
          "type": {
            "type": "string",
            "enum": ["SINGLE_TARGET", "AREA", "SLOW", "FLAME", "POISON"]
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "weapon_type": {
            "type": "string",
            "enum": ["BOW", "CROSSBOW", "CANNON", "BLADE", "SPELL", "HEROIC", "CHAOS"]
          },
          "attack_type": {
            "type": "string",
            "enum": ["NORMAL", "PIERCE", "SIEGE", "MAGIC", "HERO", "CHAOS"]
          },
          "damage_school": {
            "type": "string",
            "enum": ["PHYSICAL", "FROST", "FIRE", "POISON", "LIGHTNING", "ARCANE", "SHADOW"]
          },
          "attack_pattern": {
            "type": "string",
            "enum": [
              "SINGLE_PROJECTILE",
              "SPLASH_PROJECTILE",
              "STATUS_PROJECTILE",
              "STATUS_DOT",
              "CHAIN",
              "AURA",
              "GROUND_AREA",
              "MULTI_SHOT",
              "SUMMON_OR_TRAP"
            ]
          },
          "visual_test_enabled": {
            "type": "boolean"
          },
          "projectile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speed_cells_per_second", "hit_radius_cells"],
            "properties": {
              "speed_cells_per_second": {
                "type": "number",
                "minimum": 0
              },
              "hit_radius_cells": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tier", "damage", "range_cells", "attack_interval", "effects"],
              "properties": {
                "tier": {
                  "type": "integer",
                  "minimum": 1
                },
                "damage": {
                  "type": "number",
                  "minimum": 0
                },
                "range_cells": {
                  "type": "number",
                  "minimum": 0
                },
                "attack_interval": {
                  "type": "number",
                  "minimum": 0
                },
                "upgrade_cost": {
                  "type": "integer",
                  "minimum": 0
                },
                "upgrade_preview": {
                  "type": "string"
                },
                "effects": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["damage_primary", "splash_damage", "apply_status"]
                      },
                      "damage_multiplier": {
                        "type": "number",
                        "minimum": 0
                      },
                      "radius_cells": {
                        "type": "number",
                        "minimum": 0
                      },
                      "status_type": {
                        "type": "string",
                        "enum": ["SLOW", "BURN", "POISON"]
                      },
                      "duration": {
                        "type": "number",
                        "minimum": 0
                      },
                      "move_speed_multiplier": {
                        "type": "number",
                        "minimum": 0
                      },
                      "tick_interval": {
                        "type": "number",
                        "minimum": 0
                      },
                      "tick_damage": {
                        "type": "number",
                        "minimum": 0
                      },
                      "attack_type": {
                        "type": "string",
                        "enum": ["NORMAL", "PIERCE", "SIEGE", "MAGIC", "HERO", "CHAOS"]
                      },
                      "damage_school": {
                        "type": "string",
                        "enum": ["PHYSICAL", "FROST", "FIRE", "POISON", "LIGHTNING", "ARCANE", "SHADOW"]
                      },
                      "stack_policy": {
                        "type": "string",
                        "enum": ["REFRESH", "STRONGEST", "REPLACE", "STACK", "INDEPENDENT"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
